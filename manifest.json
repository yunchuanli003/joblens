{
  "manifest_version": 3,
  "name": "boss-scout 求职筛选助手",
  "version": "1.4.7",
  "description": "在你自己的浏览器里做岗位筛选、匹配打分与克制投递。不接管浏览器、不开启调试端口、不使用任何调试协议。",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "host_permissions": ["https://www.zhipin.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.zhipin.com/*"],
      "js": ["src/core.js", "src/extract.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "boss-scout",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "src/options.html"
}
